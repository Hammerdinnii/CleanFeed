{
  "name": "cleanfeed",
  "version": "1.0.0",
  "private": true,
  "description": "CleanFeed \u2014 a Manifest V3 ad blocker and privacy-first, fully local AI content filter for Chrome and Firefox.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs --target=chrome",
    "build:firefox": "node scripts/build.mjs --target=firefox",
    "watch": "node scripts/build.mjs --watch",
    "fetch-lists": "node scripts/fetch-lists.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"test/unit/**/*.test.ts\"",
    "test:e2e": "node scripts/build.mjs --target=chrome && node test/e2e/run.mjs",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "clean": "rm -rf dist .build",
    "icons": "node scripts/make-icons.mjs",
    "lint:firefox": "npx --yes web-ext lint -s dist/firefox --self-hosted"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "linkedom": "0.18.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "onnxruntime-web": "1.31.1"
  },
  "license": "SEE LICENSE IN README.md"
}
